# =============================================
# KrishiMitra Backend - Environment Variables
# Copy this file to .env and fill in your values
# =============================================

PORT=8080
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=krishimitra_db
DB_USER=mohnishsinghyadav
DB_PASSWORD=My@246890
DB_DIALECT=postgres

# JWT - Generate secure secrets: use `openssl rand -base64 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenWeatherMap (free tier - 1000 calls/day) → https://openweathermap.org/api
OPENWEATHER_API_KEY='97f4da4d84646302097ef60da5835171'
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# data.gov.in (free, govt API for mandi prices) → https://data.gov.in/user/register
DATAGOVIN_API_KEY=
DATAGOVIN_BASE_URL=https://api.data.gov.in/resource
DATAGOVIN_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Open-Meteo (free, no key required) → https://open-meteo.com
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend CORS
CLIENT_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=10

# =============================================
# AI Services Configuration
# =============================================

# Groq (FREE - Llama 3, Mixtral) → https://console.groq.com
# Sign up for free at console.groq.com and get API key
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-70b-versatile

# OpenAI (optional) → https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Anthropic Claude (optional) → https://console.anthropic.com
ANTHROPIC_API_KEY=

# HuggingFace (free inference for ML) → https://huggingface.co/settings/inference
HUGGINGFACE_API_KEY=
HUGGINGFACE_ENDPOINT=https://api-inference.huggingface.co

# Gemini (Google AI) → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Together AI (optional) → https://together.ai
TOGETHER_API_KEY=

# For pest detection/image analysis
# Default: Using HuggingFace free inference API
